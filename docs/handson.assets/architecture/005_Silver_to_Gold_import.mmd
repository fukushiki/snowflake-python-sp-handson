flowchart TD
  UI_SQL["🖥️ Snowsight\nWorksheet（SQL実行）"]
  UI_FILE["🖥️ Snowsight\nFiles（ファイルアップロード）"]

  subgraph STAGE["STAGEスキーマ"]
    STG["📦 内部ステージ\nSTG_TITANIC/python/"]
  end

  subgraph SILVER["SILVERスキーマ"]
    FEAT["🗃️ テーブル\nFEATURE_TITANIC"]
  end

  subgraph GOLD["GOLDスキーマ"]
    PRED["🗃️ テーブル\nPREDICTION_TITANIC"]
    SP["⚙️ ストアドプロシージャ\nSP_SILVER_TO_GOLD"]
  end

  UI_FILE -->|"Upload predict.py"| STG
  UI_SQL -->|"CREATE TABLE/PROCEDURE + CALL"| SP
  STG -->|"IMPORTS: predict.py"| SP
  FEAT -->|"SP内で学習/予測入力"| SP
  SP -->|"write_pandas(overwrite)"| PRED

  classDef extFile fill:#e8f4f8,stroke:#4a90d9,color:#1a1a2e
  classDef stageLayer fill:#f0f0f0,stroke:#888888,color:#1a1a2e
  classDef silverLayer fill:#f0f0f0,stroke:#a8a8a8,color:#2c2c2c
  classDef goldLayer fill:#fffbe6,stroke:#f5a623,color:#5c4a00
  classDef spNode fill:#eaf4ea,stroke:#4caf50,color:#1b5e20

  class UI_SQL,UI_FILE extFile
  class STG stageLayer
  class FEAT silverLayer
  class PRED goldLayer
  class SP spNode

  style STAGE fill:#f7f7f7,stroke:#bbbbbb
  style SILVER fill:#f5f5f5,stroke:#c0c0c0
  style GOLD fill:#fffdf0,stroke:#f0c040
